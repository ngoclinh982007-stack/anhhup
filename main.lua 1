--== FLY STATE ==--
local flyState = {
    active = false,
    noclip = false,
    speed = 50,
    connection = nil,
    bodyVel = nil,
    bodyGyro = nil,
    noclipConn = nil,
}

local function startFly()
    local root = getRoot()
    if not root then return end

    local bp = Instance.new("BodyPosition")
    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bp.P = 15000
    bp.D = 500
    bp.Position = root.Position
    bp.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 5000
    bg.D = 500
    bg.CFrame = root.CFrame
    bg.Parent = root

    flyState.bodyVel = bp
    flyState.bodyGyro = bg

    local hum = getHumanoid()
    if hum then hum.PlatformStand = true end

    flyState.connection = RunService.RenderStepped:Connect(function()
        if not flyState.active then return end
        local r = getRoot()
        if not r or not flyState.bodyVel then return end

        local camCF = Cam.CFrame
        local moveDir = Vector3.zero
        local hum2 = getHumanoid()

        if hum2 then
            moveDir = hum2.MoveDirection
        end

        if moveDir.Magnitude < 0.1 then
            local kb = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then kb = kb + camCF.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then kb = kb - camCF.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then kb = kb - camCF.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then kb = kb + camCF.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then kb = kb + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then kb = kb - Vector3.new(0,1,0) end
            moveDir = kb
        end

        if hum2 then
            local st = hum2:GetState()
            if st == Enum.HumanoidStateType.Jumping then
                moveDir = moveDir + Vector3.new(0, 1, 0)
            end
        end

        if moveDir.Magnitude > 0.05 then
            flyState.bodyVel.Position = r.Position + moveDir.Unit * flyState.speed * 0.1
        else
            flyState.bodyVel.Position = r.Position
        end
        flyState.bodyGyro.CFrame = camCF
    end)
end

local function stopFly()
    if flyState.connection then
        flyState.connection:Disconnect()
        flyState.connection = nil
    end
    if flyState.bodyVel then flyState.bodyVel:Destroy() flyState.bodyVel = nil end
    if flyState.bodyGyro then flyState.bodyGyro:Destroy() flyState.bodyGyro = nil end
    local hum = getHumanoid()
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

makeToggle("Fly (joystick)", false, function(s)
    flyState.active = s
    if s then startFly() else stopFly() end
end)

