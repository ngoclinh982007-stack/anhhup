local mapFrame = nil

local function showMap()
    if mapFrame then mapFrame:Destroy() end

    local root = getRoot()
    if not root then return end

    local origin = Vector3.new(0, 0, 0)
    local spawn = workspace:FindFirstChildOfClass("SpawnLocation")
    if spawn then
        origin = spawn.Position
    else
        origin = root.Position
    end

    local RANGE = 500
    local MAP_SIZE = 300
    local px = origin.X - RANGE
    local pz = origin.Z - RANGE
    local w = RANGE * 2
    local h = RANGE * 2

    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, MAP_SIZE, 0, MAP_SIZE + 40)
    f.Position = UDim2.new(0.5, -MAP_SIZE/2, 0.5, -MAP_SIZE/2 - 20)
    f.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
    f.BorderSizePixel = 0
    f.Parent = GUI
    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 12) c.Parent = f
    local s = Instance.new("UIStroke") s.Color = Color3.fromRGB(0,220,180) s.Parent = f

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -50, 0, 30)
    t.Position = UDim2.new(0, 10, 0, 6)
    t.BackgroundTransparency = 1
    t.Text = "Bấm vào bản đồ để dịch chuyển"
    t.TextColor3 = Color3.fromRGB(0, 220, 180)
    t.Font = Enum.Font.GothamBold
    t.TextSize = 13
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = f

    local mapBtn = Instance.new("TextButton")
    mapBtn.Size = UDim2.new(0, MAP_SIZE - 10, 0, MAP_SIZE - 10)
    mapBtn.Position = UDim2.new(0, 5, 0, 36)
    mapBtn.BackgroundColor3 = Color3.fromRGB(15, 30, 25)
    mapBtn.BorderSizePixel = 0
    mapBtn.Text = ""
    mapBtn.AutoButtonColor = false
    mapBtn.ClipsDescendants = true
    mapBtn.Parent = f
    local mc = Instance.new("UICorner") mc.CornerRadius = UDim.new(0, 8) mc.Parent = mapBtn

    local playerMarker = Instance.new("Frame")
    playerMarker.Size = UDim2.new(0, 8, 0, 8)
    playerMarker.AnchorPoint = Vector2.new(0.5, 0.5)
    playerMarker.BackgroundColor3 = Color3.fromRGB(80, 200, 255)
    playerMarker.BorderSizePixel = 0
    playerMarker.Parent = mapBtn
    local pmc = Instance.new("UICorner") pmc.CornerRadius = UDim.new(1, 0) pmc.Parent = playerMarker

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not f.Parent then
            if conn then conn:Disconnect() end
            return
        end
        local r = getRoot()
        if not r then return end
        local relX = (r.Position.X - px) / w
        local relZ = (r.Position.Z - pz) / h
        if relX >= 0 and relX <= 1 and relZ >= 0 and relZ <= 1 then
            playerMarker.Position = UDim2.new(relX, 0, relZ, 0)
        end
    end)

    -- Dùng InputBegan để bắt touch chính xác trên mobile
    mapBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            local pos = input.Position
            local abs = mapBtn.AbsolutePosition
            local sz = mapBtn.AbsoluteSize
            local relX = (pos.X - abs.X) / sz.X
            local relZ = (pos.Y - abs.Y) / sz.Y
            if relX >= 0 and relX <= 1 and relZ >= 0 and relZ <= 1 then
                local targetPos = Vector3.new(px + relX * w, origin.Y + 50, pz + relZ * h)
                pcall(function()
                    local r = getRoot()
                    if r then r.CFrame = CFrame.new(targetPos + Vector3.new(0, 10, 0)) end
                end)
            end
        end
    end)

    local closeMap = Instance.new("TextButton")
    closeMap.Size = UDim2.new(0, 30, 0, 30)
    closeMap.Position = UDim2.new(1, -36, 0, 6)
    closeMap.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
    closeMap.BorderSizePixel = 0
    closeMap.Text = "×"
    closeMap.TextColor3 = Color3.fromRGB(255, 100, 100)
    closeMap.Font = Enum.Font.GothamBold
    closeMap.TextSize = 18
    closeMap.Parent = f
    local cmc = Instance.new("UICorner") cmc.CornerRadius = UDim.new(0, 6) cmc.Parent = closeMap
    closeMap.MouseButton1Click:Connect(function()
        if conn then conn:Disconnect() end
        f:Destroy()
        mapFrame = nil
    end)

    mapFrame = f
end

