--== ESP ==--
local espFolder = Instance.new("Folder")
espFolder.Name = "ESP_Highlights"
espFolder.Parent = GUI

local espCache = {}
local espState = { monsters = false, players = false, npcs = false, items = false }

local function createESP(obj, color, labelText)
    if espCache[obj] then return end

    local highlight = Instance.new("Highlight")
    highlight.FillColor = color
    highlight.FillTransparency = 0.6
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = obj
    highlight.Parent = espFolder

    local adorneePart = nil
    if obj:IsA("Model") then
        adorneePart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    elseif obj:IsA("BasePart") then
        adorneePart = obj
    end

    if not adorneePart then
        highlight:Destroy()
        return
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = adorneePart
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = espFolder

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = color
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Parent = billboard

    espCache[obj] = { highlight = highlight, billboard = billboard }
end

local function clearESP()
    for obj, data in pairs(espCache) do
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
    end
    espCache = {}
end

local function isMonster(obj)
    if obj == LP.Character then return false end
    if not obj:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then return true end
    local pp = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    if pp then
        if obj:FindFirstChild("Head") then return true end
        local n = obj.Name:lower()
        if n:find("mob") or n:find("enemy") or n:find("boss") or n:find("monster") or n:find("zombie") then
            return true
        end
    end
    return false
end

local function espLoop()
    while task.wait(1) do
        if not espState.monsters and not espState.players and not espState.npcs and not espState.items then
            clearESP()
        end

        if espState.monsters then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if isMonster(obj) and not espCache[obj] then
                    createESP(obj, Color3.fromRGB(255, 60, 60), "☠ " .. obj.Name)
                end
            end
        end

        if espState.players then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP and plr.Character and not espCache[plr.Character] then
                    createESP(plr.Character, Color3.fromRGB(80, 200, 255), "👤 " .. plr.Name)
                end
            end
        end

        if espState.npcs then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) and not espCache[obj] then
                    local n = obj.Name:lower()
                    if n:find("npc") or n:find("villager") or n:find("trader") then
                        createESP(obj, Color3.fromRGB(255, 220, 80), "💬 " .. obj.Name)
                    end
                end
            end
        end

        if espState.items then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if (obj:IsA("Tool") or obj:IsA("Model") or obj:IsA("MeshPart")) and not espCache[obj] then
                    local n = obj.Name:lower()
                    if n:find("item") or n:find("chest") or n:find("loot") or n:find("pickup") or n:find("coin") then
                        createESP(obj, Color3.fromRGB(120, 255, 120), "📦 " .. obj.Name)
                    end
                end
            end
        end
    end
end

makeToggle("ESP Quái", false, function(s) espState.monsters = s end)
makeToggle("ESP Người chơi", false, function(s) espState.players = s end)
makeToggle("ESP NPC", false, function(s) espState.npcs = s end)
makeToggle("ESP Đồ", false, function(s) espState.items = s end)

task.spawn(espLoop)

